# ==========================================
# 中老双语农业病虫害防控APP — 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# .env 文件已在 .gitignore 中排除，不会提交到Git
# ==========================================

# 应用
APP_NAME=中老双语农业病虫害防控API
DEBUG=true

# 数据库 (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/laos_agri

# Redis (可选)
REDIS_URL=redis://localhost:6379/0

# ==========================================
# AI Provider 配置
# 只需修改以下三项即可切换AI模型
# ==========================================
# 提供商: openai | claude | gemini | custom
AI_PROVIDER=mock  # 开发测试用mock(零成本), 真实环境改为: openai | claude | gemini | custom
# API密钥 (必填 — 不要提交到版本控制)
AI_API_KEY=sk-your-api-key-here
# 模型名称
AI_MODEL=gpt-4o
# 自定义API地址 (使用国内代理时填写)
AI_BASE_URL=
# 最大Token数
AI_MAX_TOKENS=2000
# 温度 (0-1, 越低越确定)
AI_TEMPERATURE=0.3

# 文件上传
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=./uploads

# 安全 (生产环境务必修改)
SECRET_KEY=change-me-to-a-random-string-in-production
