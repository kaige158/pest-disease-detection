# ==========================================================
# 环境变量模板 —— 复制为 .env 后填写
#
# ⚠️ 不要手工填写随机密钥：用生成脚本更安全（避免弱值与命令历史泄露）
#     powershell -ExecutionPolicy Bypass -File scripts\generate_secrets.ps1
#
# 本文件只作为"有哪些变量"的说明，真实值请放在 .env（已在 .gitignore 中排除）
#
# 变量名必须与 application.yml 中的 ${...} 一致，否则等于没配：
#   之前本模板误写成 JWT_SECRET_KEY，而代码读的是 JWT_SECRET，
#   导致照模板配置后静默回退到弱默认值 —— 已修正。
# ==========================================================

# ---------- 必需的三个密钥（漏配会在严格模式下拒绝启动）----------

# 签发登录令牌的密钥。缺失或过弱 → 任何人都能伪造令牌
# 建议：64 位随机字符
JWT_SECRET=

# 加密数据库中 AI API Key 的主密钥（AES-256-GCM）
# ⚠️ 一旦平台保存过 AI Key 就**不要更改**：改了旧密文无法解密，
#    必须回到管理后台重新填写每个通道的 API Key
# 建议：64 位随机字符，并妥善备份
AI_KEY_SECRET=

# 管理员(admin)初始密码。留空则每次启动随机生成并打印在日志里
# 首次登录后系统会提示修改
ADMIN_INIT_PASSWORD=

# ---------- 安全开关 ----------

# true = 生产模式：任一密钥缺失/过弱就拒绝启动（正式部署必须开启）
# false = 开发/演示：只打印告警
APP_SECURITY_STRICT=true

# 本机重置管理员密码接口的令牌（scripts/reset_admin_password.ps1 使用）
# 生产环境不再需要该接口时，留空即可关闭它
OPS_TOKEN=

# ---------- 数据库（PostgreSQL）----------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/laos_agri
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# ---------- Redis（可选）----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- AI 微服务（FastAPI）地址 ----------
AI_SERVICE_URL=http://localhost:8000

# ---------- 服务端口与令牌有效期 ----------
SERVER_PORT=8080
JWT_EXPIRE_HOURS=24

# ---------- 跨域来源（生产填实际域名，逗号分隔）----------
# 留空时仅放开本机来源，适合开发
APP_CORS_ALLOWED_ORIGINS=
