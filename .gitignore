# ==========================================
# Git 忽略规则
# ==========================================

# === Flutter ===
flutter_app/.dart_tool/
flutter_app/.packages
flutter_app/build/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/android/app/google-services.json
flutter_app/android/key.properties
flutter_app/ios/Pods/
flutter_app/ios/.symlinks/
flutter_app/*.iml
flutter_app/.idea/
flutter_app/.metadata

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
env/

# === 环境变量 (含密钥 — 绝不能提交) ===
.env
!.env.example

# === 上传文件 ===
uploads/
*.log

# === APK 交付产物（二进制不入库） ===
release/

# === IDE ===
.vscode/
.idea/
*.swp
*.swo
*~

# === Maven/Java ===
target/
*.class
*.jar
*.war

# === Docker ===
docker-compose.override.yml

# === Claude Code 运行时状态 ===
.claude/scheduled_tasks.json

# === 本机调试用临时目录（含会话令牌、截图、临时脚本，绝不入库）===
.dsh-home/

# === OS ===
.DS_Store
Thumbs.db

